APP_DOMAIN=chat.example.com
APP_TAG=local
MAX_UPLOAD_MB=25
MAX_USER_STORAGE_MB=1024
# Configure your coturn relay for calls across restrictive networks.
STUN_URL=
TURN_URLS=

# Public notice shown on sign-in and in chats. Blank uses the default.
CHAT_PRIVACY_NOTICE="Superadmins can access your private messages and shared media. Chats are not end-to-end encrypted."

# Override any built-in notice; keys and placeholders are listed in docs/notices.md.
# Keep outer single quotes around the JSON. These values are public UI text.
APP_NOTICES_JSON='{}'
# Example: APP_NOTICES_JSON='{"CONFESSION_PRIVACY_NOTICE":"Authors are hidden from members, but visible to superadmins.","BLOCKED_CHAT_NOTICE":"You can read this chat. New messages and calls are blocked."}'
