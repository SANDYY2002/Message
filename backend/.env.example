NODE_ENV=development
PORT=3005
PUBLIC_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=message
DB_PASSWORD=change-this-password
DB_NAME=message
# Absolute paths supported. Relative paths resolve from backend/.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
MAX_USER_STORAGE_MB=1024
SESSION_DAYS=7
# Set true only behind HTTPS. Use HTTPS in production.
COOKIE_SECURE=false
# 0 for direct access, 1 when exactly one trusted reverse proxy is in front.
TRUST_PROXY=0
