{
  "name": "message",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "test": "npm test -w backend",
    "test:integration": "npm run test:integration -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.7"
  }
}
